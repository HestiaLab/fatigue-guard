<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package Name="FatigueGuard"
           Manufacturer="HestiaLab"
           Version="$(var.ProductVersion)"
           UpgradeCode="A697C069-8BF5-43C1-B784-91520A9CB05C"
           Scope="perUser"
           Language="2052"
           Codepage="936">

    <MajorUpgrade DowngradeErrorMessage="已安装更新版本的 FatigueGuard，请先在“设置 → 应用”中卸载后再安装。" />
    <MediaTemplate EmbedCab="yes" />
    <Launch Condition="VersionNT64" Message="FatigueGuard 需要 64 位 Windows（x64）。" />

    <Property Id="ARPCOMMENTS" Value="本地离线的摄像头疲劳监测命令行工具；不联网、不上传、不保存画面。" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/HestiaLab/fatigue-guard" />
    <Property Id="ARPHELPLINK" Value="https://github.com/HestiaLab/fatigue-guard#readme" />

    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />

    <Feature Id="Main" Title="FatigueGuard" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>
  </Package>

  <Fragment>
    <!-- 按用户安装到 %LOCALAPPDATA%\Programs，无需管理员权限。
         ICE38/ICE64/ICE91 针对漫游用户配置与 ALLUSERS 切换；本包是固定的按用户安装，
         LocalAppData 不参与漫游，文件随组件卸载删除，因此抑制这几条校验。 -->
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="FatigueGuard" />
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppStartMenuFolder" Name="FatigueGuard" />
    </StandardDirectory>
  </Fragment>

  <Fragment>
    <Component Id="StartMenuShortcut" Directory="AppStartMenuFolder">
      <Shortcut Id="FatigueGuardShortcut"
                Name="FatigueGuard"
                Description="本地离线的摄像头疲劳监测命令行工具"
                Target="[INSTALLFOLDER]FatigueGuard.exe"
                WorkingDirectory="INSTALLFOLDER" />
      <RemoveFolder Id="RemoveAppStartMenuFolder" On="uninstall" />
      <RegistryValue Root="HKCU"
                     Key="Software\HestiaLab\FatigueGuard"
                     Name="StartMenuShortcut"
                     Type="integer"
                     Value="1"
                     KeyPath="yes" />
    </Component>
  </Fragment>

  <Fragment>
    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Files Include="$(var.StagingDir)\**" />
    </ComponentGroup>
  </Fragment>

</Wix>
